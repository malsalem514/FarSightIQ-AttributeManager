# Server Configuration
PORT=3002
NODE_ENV=production

# Oracle Database Configuration
# REQUIRED: User with access to ATTR_MGR schema
ORACLE_USER=ATTR_MGR
ORACLE_PASSWORD=your_password_here
# Format: host:port/service_name or TNS alias
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
# Optional: Path to Oracle Instant Client (Windows only, usually not needed on Linux)
# ORACLE_CLIENT_PATH=C:\oracle\instantclient_19_28

# Pool Configuration
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=20
ORACLE_QUEUE_MAX=500

# LLM Provider Configuration
# Choose: openai or gemini
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1

# Gemini Configuration (Optional fallback)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TEMPERATURE=0.1

# AI Cache Configuration
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=2592000

# Security (CORS)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://your-production-url.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

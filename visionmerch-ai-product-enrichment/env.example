# Attribute Manager Frontend Configuration (Vite)

# Backend API Base URL
# Points to the Express.js server
VITE_API_URL=http://localhost:3002/api

# Primary Business Unit ID for this tenant/environment
VITE_BUSINESS_UNIT_ID=1

# Development Flags
# Set to 'true' to use local mock data instead of live Oracle/AI
VITE_USE_MOCK_DATA=false
